# Neon connection string (create a NEW project in your Neon account for Compasso)
DATABASE_URL=postgresql://user:password@ep-xxxxxx.sa-east-1.aws.neon.tech/compasso?sslmode=require

# Clerk (https://dashboard.clerk.com): API Keys page of your application
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# Clerk webhook: Dashboard > Webhooks > your endpoint > Signing Secret (whsec_...)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxx

# Better Auth (ADR-033). Secret: `openssl rand -base64 32` (>= 32 chars). URL: public origin of the app (no trailing slash).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Transactional mail (Resend). MAIL_FROM must use a domain verified in Resend, e.g. "Compasso <no-reply@your-domain>".
RESEND_API_KEY=
MAIL_FROM=
# Social sign-in (optional; a provider is enabled only when both values are set). Callback: <BETTER_AUTH_URL>/api/auth/callback/<google|github>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
